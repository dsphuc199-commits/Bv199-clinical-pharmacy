    {
      "id": "pids-effusion",
      "kind": "primary",
      "when": {
        "source": "idsa",
        "idsa_version": "effusion"
      },
      "summary": [
        {
          "label": "Phạm vi",
          "text": "IDSA/PIDS 2026 · Phần 1 về tràn dịch cạnh viêm phổi hoặc mủ màng phổi ở trẻ trên 3 tháng."
        },
        {
          "label": "Điều trị kháng sinh",
          "text": "Bản cập nhật tập trung vào đánh giá và xử trí dịch màng phổi. Liều kháng sinh cần xây dựng theo vi sinh, mức độ nặng và quy trình nhiễm khuẩn có biến chứng."
        }
      ],
      "blocks": [
        {
          "title": "Đánh giá dịch màng phổi và chỉ định dẫn lưu",
          "items": [
            {
              "role": "Dịch vừa hoặc nhiều trên X-quang",
              "text": "Ưu tiên siêu âm ngực để đánh giá kích thước và tính chất dịch. Có thể dùng CT hoặc MRI khi thiếu siêu âm.",
              "grade": "C-VL",
              "ref": "The Use of Chest Ultrasound",
              "source_ids": [
                "pids2026"
              ]
            },
            {
              "role": "Dịch ít, không biến chứng",
              "text": "Theo dõi thay cho dẫn lưu thường quy.",
              "grade": "C-VL",
              "ref": "Pleural Fluid Drainage versus Observation, KC 1",
              "source_ids": [
                "pids2026"
              ]
            },
            {
              "role": "Dịch vừa kèm dấu hiệu gắng sức hô hấp, dịch nhiều hoặc có mủ",
              "text": "Dẫn lưu màng phổi. Khuyến cáo tiếp nối năm 2011, chưa có bằng chứng mới.",
              "ref": "Pleural Fluid Drainage versus Observation, KC 2",
              "source_ids": [
                "pids2026"
              ]
            }
          ]
        },
        {
          "title": "Phương án khi cần dẫn lưu",
          "items": [
            {
              "role": "Phương án đầu tay ở đa số ca mủ màng phổi",
              "text": "Ống dẫn lưu phối hợp tiêu sợi huyết nội màng phổi. Cân nhắc nội soi lồng ngực khi nhiều vách hóa hoặc thất bại.",
              "grade": "C-VL",
              "ref": "Pleural Fluid Drainage compared to Surgical Debridement",
              "source_ids": [
                "pids2026"
              ]
            },
            {
              "role": "Kích cỡ ống dẫn lưu",
              "text": "Ưu tiên ống nhỏ ≤12 Fr.",
              "grade": "C-VL",
              "ref": "Choice of Chest Tube Size",
              "source_ids": [
                "pids2026"
              ]
            },
            {
              "role": "Tiêu sợi huyết theo chuyên khoa",
              "text": "Ưu tiên tPA đơn độc thay cho tPA phối hợp DNase. Chọn liều theo quy trình chuyên khoa.",
              "grade": "C-L",
              "ref": "Use of tPA and DNase or tPA Alone for Fibrinolysis",
              "source_ids": [
                "pids2026"
              ]
            }
          ]
        }
      ],
      "notes": [],
      "source_ids": [
        "pids2026"
      ]
