  "conflicts": [
    {
      "id": "abrsp-c-first",
      "topic": "Kháng sinh đầu tay",
      "sides": [
        {
          "sourceId": "AAP-2013-sinusitis",
          "year": 2013,
          "text": "Amoxicillin có hoặc không kèm clavulanate; amoxicillin liều chuẩn 45 mg/kg/ngày cho bệnh nhẹ–vừa không có yếu tố nguy cơ.",
          "citation": {
            "sourceId": "AAP-2013-sinusitis",
            "locator": "KAS 4, tr. e269; tr. e271"
          }
        },
        {
          "sourceId": "IDSA-2012-ABRS",
          "year": 2012,
          "text": "Amoxicillin-clavulanate thay vì amoxicillin đơn thuần (strong, moderate).",
          "citation": {
            "sourceId": "IDSA-2012-ABRS",
            "locator": "Khuyến cáo 3, tr. e2"
          }
        },
        {
          "sourceId": "NICE-NG79",
          "year": 2017,
          "text": "Phenoxymethylpenicillin liều theo tuổi, 4 lần/ngày × 5 ngày; co-amoxiclav nếu toàn thân rất mệt hoặc nguy cơ cao biến chứng.",
          "citation": {
            "sourceId": "NICE-NG79",
            "locator": "Bảng 2, tr. 10"
          }
        }
      ]
    },
    {
      "id": "abrsp-c-duration",
      "topic": "Thời gian điều trị",
      "sides": [
        {
          "sourceId": "AAP-2013-sinusitis",
          "year": 2013,
          "text": "Chưa nghiên cứu hệ thống; đề xuất 7 ngày sau khi hết triệu chứng (tối thiểu 10 ngày).",
          "citation": {
            "sourceId": "AAP-2013-sinusitis",
            "locator": "tr. e271, e273"
          }
        },
        {
          "sourceId": "IDSA-2012-ABRS",
          "year": 2012,
          "text": "10–14 ngày (weak, low-moderate).",
          "citation": {
            "sourceId": "IDSA-2012-ABRS",
            "locator": "Khuyến cáo 15, tr. e3"
          }
        },
        {
          "sourceId": "NICE-NG79",
          "year": 2017,
          "text": "5 ngày.",
          "citation": {
            "sourceId": "NICE-NG79",
            "locator": "Bảng 2, tr. 10–11"
          }
        }
      ]
    },
    {
      "id": "abrsp-c-benefit",
      "topic": "Lợi ích kháng sinh",
      "sides": [
        {
          "sourceId": "AAP-2013-sinusitis",
          "year": 2013,
          "text": "Khởi phát nặng hoặc diễn biến xấu đi: kê kháng sinh (Strong Recommendation, B).",
          "citation": {
            "sourceId": "AAP-2013-sinusitis",
            "locator": "KAS 3A, tr. e267"
          }
        },
        {
          "sourceId": "EPOS-2020",
          "year": 2020,
          "text": "Dữ liệu rất hạn chế; không khác biệt có ý nghĩa so với giả dược, tăng tác dụng bất lợi (1a (-)).",
          "citation": {
            "sourceId": "EPOS-2020",
            "locator": "Bảng 1.4.5, tr. 9"
          }
        }
      ]
    },
    {
      "id": "abrsp-c-persistent",
      "topic": "Bệnh kéo dài (≥ 10 ngày không cải thiện)",
      "sides": [
        {
          "sourceId": "AAP-2013-sinusitis",
          "year": 2013,
          "text": "Kê kháng sinh hoặc theo dõi ngoại trú thêm 3 ngày (Recommendation, Evidence Quality: B).",
          "citation": {
            "sourceId": "AAP-2013-sinusitis",
            "locator": "KAS 3B, tr. e268"
          }
        },
        {
          "sourceId": "NICE-NG79",
          "year": 2017,
          "text": "Cân nhắc không kê kháng sinh hoặc kê đơn dự phòng (back-up).",
          "citation": {
            "sourceId": "NICE-NG79",
            "locator": "Khuyến cáo 1.1.5, tr. 7"
          }
        }
      ]
    }
