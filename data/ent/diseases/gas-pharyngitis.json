  "evidenceGap": [],
  "redFlags": [
    {
      "id": "gas-rf-suppurative",
      "kind": "recommendation",
      "role": "primary",
      "text": "Nghi biến chứng mủ (áp xe quanh amidan, áp xe sau họng, viêm hạch cổ mủ, viêm xương chũm): xem trang bệnh tương ứng; biến chứng hay gặp hơn sau nhiễm khuẩn không được điều trị.",
      "citation": {
        "sourceId": "CDC-GAS",
        "locator": "Mục Complications"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-rf-highrisk",
      "kind": "recommendation",
      "role": "diagnosis",
      "text": "Người nguy cơ cao (tiếp xúc hộ gia đình với ca liên cầu nhóm A, tiền sử thấp tim, nghi nhiễm khuẩn tại chỗ hoặc toàn thân có biến chứng như áp xe quanh amidan/sau họng, tinh hồng nhiệt, hội chứng sốc nhiễm độc): cân nhắc mạnh việc xét nghiệm dù điểm lâm sàng thấp.",
      "citation": {
        "sourceId": "IDSA-2025-GAS-part1",
        "locator": "Recommendation – Remarks (cập nhật 14/10/2025)"
      },
      "status": "EXTRACTED"
    },
    {
      "status": "EXTRACTED",
      "id": "gas-rf-nice-refer",
      "kind": "recommendation",
      "role": "comparison",
      "text": "Chuyển viện khi đau họng cấp kèm nhiễm khuẩn toàn thân nặng hoặc biến chứng mủ nặng: áp xe quanh amidan (quinsy) hoặc viêm mô tế bào, áp xe cạnh họng, áp xe sau họng, hội chứng Lemierre.",
      "citation": {
        "sourceId": "NICE-NG84",
        "locator": "Khuyến cáo 1.1.13, tr. 8"
      }
    }
  ],
  "statements": [
    {
      "id": "gas-idsa25-score",
      "kind": "recommendation",
      "role": "diagnosis",
      "text": "Dùng thang điểm lâm sàng để quyết định xét nghiệm liên cầu nhóm A ở trẻ em và người lớn đau họng.",
      "strength": "conditional recommendation",
      "quality": "very low certainty of evidence",
      "citation": {
        "sourceId": "IDSA-2025-GAS-part1",
        "locator": "Recommendation: Risk Assessment Using Clinical Scoring Systems",
        "quote": "we suggest using a clinical scoring system"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa25-part1",
      "kind": "evidence",
      "role": "diagnosis",
      "text": "IDSA 2025 là Part 1 của bản cập nhật hướng dẫn 2012; các vấn đề khác (gồm điều trị) sẽ được đề cập ở các bản cập nhật sau.",
      "citation": {
        "sourceId": "IDSA-2025-GAS-part1",
        "locator": "Introduction"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r1",
      "kind": "recommendation",
      "role": "primary",
      "text": "Lấy dịch họng làm test kháng nguyên nhanh (RADT) và/hoặc cấy, vì lâm sàng không phân biệt được liên cầu nhóm A với virus, trừ khi có biểu hiện virus rõ (sổ mũi, ho, loét miệng, khàn tiếng). Trẻ em và vị thành niên có RADT âm tính: cấy lại xác nhận.",
      "strength": "strong",
      "quality": "high",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 1 (mục I), tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r2",
      "kind": "recommendation",
      "role": "primary",
      "text": "Người lớn có RADT âm tính: không cần cấy lại thường quy.",
      "strength": "strong",
      "quality": "moderate",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 2, tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r5",
      "kind": "recommendation",
      "role": "primary",
      "text": "Trẻ < 3 tuổi: không chỉ định xét nghiệm liên cầu nhóm A thường quy; cân nhắc khi có yếu tố nguy cơ (ví dụ anh chị em nhiễm liên cầu nhóm A).",
      "strength": "strong",
      "quality": "moderate",
      "population": "child",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 5, tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r6",
      "kind": "recommendation",
      "role": "primary",
      "text": "Không xét nghiệm lại thường quy sau điều trị.",
      "strength": "strong",
      "quality": "high",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 6, tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r8",
      "kind": "recommendation",
      "role": "primary",
      "text": "Điều trị viêm họng do liên cầu nhóm A bằng kháng sinh phù hợp, đủ liều, đủ thời gian diệt vi khuẩn ở họng (thường 10 ngày); penicillin hoặc amoxicillin là lựa chọn cho người không dị ứng.",
      "strength": "strong",
      "quality": "high",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 8 (mục III), tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r9",
      "kind": "recommendation",
      "role": "primary",
      "text": "Dị ứng penicillin: cephalosporin thế hệ 1 (khi không có phản vệ) 10 ngày, clindamycin hoặc clarithromycin 10 ngày, hoặc azithromycin 5 ngày.",
      "strength": "strong",
      "quality": "moderate",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 9, tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-adj",
      "kind": "recommendation",
      "role": "primary",
      "text": "Có thể dùng thuốc giảm đau, hạ sốt (acetaminophen hoặc NSAID) hỗ trợ khi triệu chứng vừa–nặng hoặc sốt cao; tránh aspirin ở trẻ em (strong, moderate); không khuyến cáo corticosteroid hỗ trợ (weak, moderate).",
      "strength": "strong",
      "quality": "high",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 10, tr. e87"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-idsa12-r13",
      "kind": "recommendation",
      "role": "primary",
      "text": "Không cắt amidan chỉ để giảm số đợt viêm họng do liên cầu nhóm A.",
      "strength": "strong",
      "quality": "high",
      "citation": {
        "sourceId": "IDSA-2012-GAS",
        "locator": "Khuyến cáo 13, tr. e88"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-cdc-treat",
      "kind": "recommendation",
      "role": "primary",
      "text": "Mọi lứa tuổi có RADT hoặc cấy họng dương tính cần kháng sinh; không dùng kháng sinh cho viêm họng do virus.",
      "citation": {
        "sourceId": "CDC-GAS",
        "locator": "Mục Treatment",
        "quote": "need antibiotics. Don't treat viral pharyngitis with antibiotics"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-cdc-diag",
      "kind": "recommendation",
      "role": "primary",
      "text": "Có biểu hiện virus: chẩn đoán lâm sàng, không cần xét nghiệm liên cầu nhóm A. Trẻ ≥ 3 tuổi có triệu chứng và RADT âm tính: cấy họng xác nhận; các lứa tuổi khác không cần cấy lại thường quy.",
      "citation": {
        "sourceId": "CDC-GAS",
        "locator": "Mục Diagnosis"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-cdc-allergy",
      "kind": "recommendation",
      "role": "primary",
      "text": "Tránh cefalexin và cefadroxil ở người quá mẫn tức thì với penicillin.",
      "citation": {
        "sourceId": "CDC-GAS",
        "locator": "Mục Treatment – penicillin allergy"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "gas-cdc-resistance",
      "kind": "evidence",
      "role": "primary",
      "text": "Chưa ghi nhận liên cầu nhóm A kháng penicillin hoặc cephalosporin; kháng azithromycin, clarithromycin, clindamycin thay đổi theo địa lý và thời gian.",
      "citation": {
        "sourceId": "CDC-GAS",
        "locator": "Mục Treatment – resistance"
      },
      "status": "EXTRACTED"
    },
    {
