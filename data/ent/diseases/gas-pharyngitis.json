    {
      "status": "EXTRACTED",
      "id": "gas-nice-scores",
      "kind": "recommendation",
      "role": "comparison",
      "text": "Dùng thang điểm FeverPAIN hoặc Centor để xác định người có khả năng hưởng lợi từ kháng sinh. FeverPAIN 0–1 hoặc Centor 0–2: không kê kháng sinh. FeverPAIN 2–3: cân nhắc không kê hoặc kê đơn dự phòng (back-up), dùng nếu không bắt đầu cải thiện trong 3–5 ngày. FeverPAIN 4–5 hoặc Centor 3–4: cân nhắc kê ngay hoặc kê đơn dự phòng.",
      "citation": {
        "sourceId": "NICE-NG84",
        "locator": "Khuyến cáo 1.1.3, 1.1.6–1.1.10, tr. 5–7"
      }
    },
    {
      "status": "EXTRACTED",
      "id": "gas-nice-unwell",
      "kind": "recommendation",
      "role": "comparison",
      "text": "Toàn thân rất mệt, có triệu chứng và dấu hiệu bệnh nặng hơn hoặc nguy cơ cao biến chứng: kê kháng sinh ngay.",
      "citation": {
        "sourceId": "NICE-NG84",
        "locator": "Khuyến cáo 1.1.12, tr. 8"
      }
    },
    {
      "status": "EXTRACTED",
      "id": "gas-nice-rapid",
      "kind": "recommendation",
      "role": "comparison",
      "text": "Không khuyến cáo áp dụng thường quy test nhanh liên cầu nhóm A cho người đau họng.",
      "citation": {
        "sourceId": "NICE-NG84",
        "locator": "Mục 1.1 (sau khuyến cáo 1.1.5), tr. 5"
      }
    },
    {
      "status": "EXTRACTED",
      "id": "gas-nice-steroid",
      "kind": "evidence",
      "role": "comparison",
      "text": "Hội đồng không khuyến cáo corticosteroid để điều trị đau họng cấp (bệnh tự giới hạn, lo ngại an toàn và nguy cơ điều trị lặp lại).",
      "citation": {
        "sourceId": "NICE-NG84",
