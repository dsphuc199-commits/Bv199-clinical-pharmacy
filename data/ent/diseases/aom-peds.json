  "statements": [
    {
      "id": "aom-kas1a",
      "kind": "recommendation",
      "role": "primary",
      "text": "Chẩn đoán viêm tai giữa cấp khi màng nhĩ phồng vừa–nhiều hoặc chảy mủ tai mới xuất hiện không do viêm tai ngoài.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 1A, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas1c",
      "kind": "recommendation",
      "role": "primary",
      "text": "Không chẩn đoán viêm tai giữa cấp khi không có tràn dịch tai giữa (soi tai khí nén và/hoặc đo nhĩ lượng).",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 1C, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas2",
      "kind": "recommendation",
      "role": "primary",
      "text": "Đánh giá đau ở mọi trẻ viêm tai giữa cấp; có đau thì điều trị giảm đau.",
      "strength": "Strong Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 2, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas3a",
      "kind": "recommendation",
      "role": "primary",
      "text": "Kê kháng sinh cho trẻ ≥ 6 tháng có triệu chứng nặng (đau tai vừa–nặng, đau tai ≥ 48 giờ hoặc sốt ≥ 39 °C), một hoặc hai bên.",
      "strength": "Strong Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 3A, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas3b",
      "kind": "recommendation",
      "role": "primary",
      "text": "Kê kháng sinh cho trẻ 6–23 tháng viêm tai giữa cấp hai bên không có triệu chứng nặng.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 3B, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas3c",
      "kind": "recommendation",
      "role": "primary",
      "text": "Trẻ 6–23 tháng viêm tai giữa cấp một bên không có triệu chứng nặng: kê kháng sinh hoặc theo dõi sát, quyết định cùng gia đình; nếu theo dõi phải có cơ chế tái khám và bắt đầu kháng sinh khi nặng lên hoặc không cải thiện sau 48–72 giờ.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 3C, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas3d",
      "kind": "recommendation",
      "role": "primary",
      "text": "Trẻ ≥ 24 tháng viêm tai giữa cấp (một hoặc hai bên) không có triệu chứng nặng: kê kháng sinh hoặc theo dõi sát, quyết định cùng gia đình; cần cơ chế tái khám như trên.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 3D, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas4a",
      "kind": "recommendation",
      "role": "primary",
      "text": "Khi đã quyết định dùng kháng sinh: amoxicillin, nếu trẻ không dùng amoxicillin trong 30 ngày qua, không viêm kết mạc mủ kèm theo và không dị ứng penicillin.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 4A, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas4b",
      "kind": "recommendation",
      "role": "primary",
      "text": "Dùng kháng sinh phủ thêm beta-lactamase khi trẻ đã dùng amoxicillin trong 30 ngày qua, có viêm kết mạc mủ kèm theo, hoặc có tiền sử viêm tai giữa cấp tái phát không đáp ứng amoxicillin.",
      "strength": "Recommendation",
      "quality": "Grade C",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 4B, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
      "id": "aom-kas4c",
      "kind": "recommendation",
      "role": "primary",
      "text": "Đánh giá lại khi người chăm sóc báo triệu chứng nặng lên hoặc không đáp ứng kháng sinh ban đầu sau 48–72 giờ, quyết định có đổi thuốc hay không.",
      "strength": "Recommendation",
      "quality": "Grade B",
      "population": "child",
      "citation": {
        "sourceId": "AAP-2013-AOM",
        "locator": "KAS 4C, tr. e965"
      },
      "status": "EXTRACTED"
    },
    {
