.wrap{max-width:1420px;margin:0 auto;padding:24px;color:#12243a;font-family:Arial,sans-serif}.hero{border-radius:18px;background:linear-gradient(110deg,#0a6471,#0c8291);padding:27px 30px;color:white}.kicker{font-size:11px;letter-spacing:2px;font-weight:700}.hero h1{font-size:29px;margin:10px 0}.hero p{opacity:.9;font-size:14px;margin:0}.notice{background:#fff8eb;border:1px solid #ead5a9;margin:18px 0;padding:15px;border-radius:12px;font-size:13px}.layout{display:grid;grid-template-columns:290px minmax(0,1fr);gap:18px;align-items:start}.sidebar,.main{background:#fff;border:1px solid #dae3ec;border-radius:16px;padding:20px}.sidebar{position:sticky;top:12px;max-height:82vh;overflow:auto}.sidebar h2{font-size:16px}.sidebar input,.sidebar select{box-sizing:border-box;width:100%;margin:6px 0;padding:11px;border:1px solid #ccd9e7;border-radius:9px;color:#10283c;background:white}.count{font-size:12px;color:#6e8193;margin:9px 0}.item,.active{display:flex;flex-direction:column;text-align:left;width:100%;border:1px solid #dce7ef;border-radius:10px;padding:12px;background:white;margin-bottom:8px;cursor:pointer;color:#1b3144}.active{background:#e8f7f5;border-color:#22a79b}.item b,.active b{font-size:13px}.item small,.active small{color:#647b90;margin-top:6px}.head{padding:4px 2px 15px;border-bottom:1px solid #e3e9f0}.head span{font-size:12px;color:#0e837d;font-weight:700}.head h2{font-size:24px;margin:11px 0}.head p,.muted{font-size:13px;color:#577086;line-height:1.7}.main section{padding:19px 0;border-bottom:1px solid #e3e9f0}.main h3{font-size:16px;margin:0 0 13px}.main ul{padding-left:20px;line-height:1.8;font-size:13px}.regimens{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.regimen{border:1px solid #d6e4eb;border-radius:13px;padding:16px;background:#f9fcfd}.reghead{display:flex;justify-content:space-between;align-items:center;gap:8px}.reghead strong{font-size:16px}.reghead span{font-size:11px;border-radius:20px;color:#057c74;background:#e0f6ee;padding:6px 9px}.regimen dl{display:grid;grid-template-columns:112px 1fr;gap:10px 6px;font-size:13px;line-height:1.5;margin-bottom:0}.regimen dt{color:#62788d}.regimen dd{margin:0;font-weight:600}.empty{padding:18px;background:#fff9ec;border:1px dashed #e5c87e;border-radius:12px;font-size:13px}.source{display:flex;justify-content:space-between;align-items:center;gap:12px;text-decoration:none;color:#075d74;padding:12px 0;border-bottom:1px solid #edf1f5;font-size:13px}.source small{font-size:11px;color:#647b90;white-space:nowrap} :global(footer){font-size:11px;line-height:1.7;color:#688098;padding-top:18px}@media(max-width:850px){.layout{grid-template-columns:1fr}.sidebar{position:static;max-height:none}.regimens{grid-template-columns:1fr}.source{align-items:flex-start;flex-direction:column}.wrap{padding:10px}}

